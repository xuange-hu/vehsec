# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual envs
.venv/
venv/

# Tool output
*.log
candump*.log
captures/
*.asc
*.blf

# ...but `examples/sample_candump.log` is a fixture, not output. It is matched
# by `*.log` above, so `git add` silently refused it and CI (which only sees the
# checkout) died with FileNotFoundError on tests/test_assets.py. Negation must
# come after the wildcard to take effect.
!examples/sample_candump.log

# generated by labs/v2x-ecdsa-nonce/solve.py --out (both the root copy and the
# lab-local copy are rewritten on every run with fresh random keys, so neither
# belongs in git — keeping them tracked only produces perpetual dirty diffs)
/signatures.json
labs/**/signatures.json

# Test / cache
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
